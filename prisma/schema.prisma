// Prisma schema - Sistema de agendamentos Nail Design
// Banco: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // connection pooling (pgbouncer) - usado em runtime
  directUrl = env("DIRECT_URL")     // conexão direta - usado só pelo Prisma Migrate
}

// Cliente do salão. Login feito por telefone + CPF.
model User {
  id        String   @id @default(uuid())
  phone     String   @unique // armazenado somente com dígitos, ex: "11999998888"
  cpf       String   @unique // armazenado somente com dígitos, 11 caracteres
  name      String?
  source    String? // De onde veio: Instagram, Indicação, Panfleto, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@map("users")
}

// Catálogo de procedimentos oferecidos
model Procedure {
  id          String   @id @default(uuid())
  name        String // Ex: "Esmaltação em Gel", "Alongamento no molde F1"
  price        Decimal @db.Decimal(10, 2)
  durationMin Int // duração média em minutos, usada para calcular disponibilidade
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String

  appointments Appointment[]

  @@map("procedures")
}

// Ficha de anamnese preenchida antes da confirmação de cada agendamento
model Anamnesis {
  id               String   @id @default(uuid())
  appointmentId    String   @unique
  hasNailFungus    Boolean  @default(false) // possui fungo/micose
  hasGelOrAcrylic  Boolean  @default(false) // já possui gel/acrílico na unha
  isPregnant       Boolean  @default(false)
  hasDiabetes      Boolean  @default(false)
  hasAllergies     Boolean  @default(false)
  allergiesDetails String?
  medicationsInUse String?
  observations     String?
  createdAt        DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("anamnesis_forms")
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

// Agendamento realizado pelo cliente
model Appointment {
  id            String            @id @default(uuid())
  userId        String
  procedureId   String
  startTime     DateTime
  endTime       DateTime
  status        AppointmentStatus @default(SCHEDULED)
  clientEmail   String? // opcional, para envio de convite do Google Agenda
  googleEventId String? // id do evento criado no Google Calendar
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  procedure Procedure  @relation(fields: [procedureId], references: [id])
  anamnesis Anamnesis?

  @@index([startTime])
  @@index([userId])
  @@map("appointments")
}

// Horário de funcionamento por dia da semana (0=domingo ... 6=sábado)
model WorkingHours {
  id        String  @id @default(uuid())
  weekday   Int     @unique
  startTime String // formato "HH:mm", ex: "09:00"
  endTime   String // formato "HH:mm", ex: "18:00"
  active    Boolean @default(true)

  @@map("working_hours")
}

// Datas específicas bloqueadas (feriados, folgas, etc.)
model BlockedDate {
  id     String   @id @default(uuid())
  date   DateTime @unique @db.Date
  reason String?

  @@map("blocked_dates")
}
