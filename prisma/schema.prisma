generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String        @id @default(uuid())
  phone         String        @unique
  cpf           String?       @unique
  name          String?
  source        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  anoNascimento String?
  appointments  Appointment[]

  @@map("users")
}

model AdminUser {
  id                    String                 @id @default(uuid())
  username              String                 @unique
  passwordHash          String
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sessions              AdminSession[]
  financialTransactions FinancialTransaction[]

  @@map("admin_users")
}

model AdminSession {
  id          String    @id @default(uuid())
  adminUserId String
  apiKeyHash  String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model Procedure {
  id           String        @id @default(uuid())
  name         String
  price        Decimal       @db.Decimal(10, 2)
  durationMin  Int
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  description  Json?
  appointments Appointment[]

  @@map("procedures")
}

model Anamnesis {
  id                          String      @id @default(uuid())
  appointmentId               String      @unique
  isFirstVisit                Boolean     @default(false)
  usesGelPolish               Boolean     @default(false)
  hasCosmeticAllergy          Boolean     @default(false)
  cosmeticAllergyDetails      String?
  hasFrequentLifting          Boolean     @default(false)
  usesContinuousMedication    Boolean     @default(false)
  continuousMedicationDetails String?
  createdAt                   DateTime    @default(now())
  appointment                 Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // Colunas antigas preservadas apenas para manter o histórico existente.
  legacyHasNailFungus   Boolean @default(false) @map("hasNailFungus") @ignore
  legacyHasGelOrAcrylic Boolean @default(false) @map("hasGelOrAcrylic") @ignore
  legacyIsPregnant      Boolean @default(false) @map("isPregnant") @ignore
  legacyHasDiabetes     Boolean @default(false) @map("hasDiabetes") @ignore
  legacyObservations    String? @map("observations") @ignore

  @@map("anamnesis_forms")
}

model Appointment {
  id                     String                 @id @default(uuid())
  userId                 String
  procedureId            String
  startTime              DateTime
  endTime                DateTime
  status                 AppointmentStatus      @default(SCHEDULED)
  clientEmail            String?
  googleEventId          String?
  totalPrice             Decimal?               @db.Decimal(10, 2)
  basePrice              Decimal?               @db.Decimal(10, 2)
  priceAdjustmentType    PriceAdjustmentType?
  priceAdjustmentAmount  Decimal                @default(0) @db.Decimal(10, 2)
  priceAdjustmentReason  String?
  amountPaid             Decimal                @default(0) @db.Decimal(10, 2)
  remainingPaymentMethod String?
  notes                  String?
  confirmedAt            DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  anamnesis              Anamnesis?
  procedure              Procedure              @relation(fields: [procedureId], references: [id])
  user                   User                   @relation(fields: [userId], references: [id])
  financialTransactions  FinancialTransaction[]

  // Coluna antiga preservada apenas para manter o histórico existente.
  legacyHasGelOrAcrylic Boolean @default(false) @map("hasGelOrAcrylic") @ignore

  @@index([startTime])
  @@index([userId])
  @@index([status, startTime])
  @@map("appointments")
}

model FinancialTransaction {
  id            String                   @id @default(uuid())
  type          FinancialTransactionType
  category      String
  description   String
  amount        Decimal                  @db.Decimal(10, 2)
  occurredAt    DateTime
  paymentMethod String?
  notes         String?
  appointmentId String?                  @unique
  adminUserId   String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  appointment   Appointment?             @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  adminUser     AdminUser?               @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([type, occurredAt])
  @@index([category])
  @@map("financial_transactions")
}

model WorkingHours {
  id             String  @id @default(uuid())
  weekday        Int     @unique
  startTime      String
  endTime        String
  active         Boolean @default(true)
  lunchStartTime String?
  lunchEndTime   String?

  @@map("working_hours")
}

model BlockedDate {
  id     String   @id @default(uuid())
  date   DateTime @unique @db.Date
  reason String?

  @@map("blocked_dates")
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum PriceAdjustmentType {
  DISCOUNT
  ADDITIONAL
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
}
